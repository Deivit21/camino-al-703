        <SteadyState Duration="60" Power="0.66" Cadence="85"/>
        <SteadyState Duration="300" Power="0.7" Cadence="95"/>
        <SteadyState Duration="60" Power="0.66" Cadence="85"/>
        <SteadyState Duration="300" Power="0.7" Cadence="95"/>
        <SteadyState Duration="180" Power="0.66" Cadence="85"/>
        <Cooldown Duration="600" PowerLow="0.62" PowerHigh="0.5" Cadence="85"/>
    </workout>
</workout_file>
